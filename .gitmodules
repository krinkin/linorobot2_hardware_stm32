[submodule "firmware_stm32/vendor/cmsis_device_f4"]
	path = firmware_stm32/vendor/cmsis_device_f4
	url = https://github.com/STMicroelectronics/cmsis_device_f4
[submodule "firmware_stm32/vendor/cmsis_core"]
	path = firmware_stm32/vendor/cmsis_core
	url = https://github.com/STMicroelectronics/cmsis_core
[submodule "firmware_stm32/vendor/stm32f4xx_hal_driver"]
	path = firmware_stm32/vendor/stm32f4xx_hal_driver
	url = https://github.com/STMicroelectronics/stm32f4xx_hal_driver
[submodule "firmware_stm32/vendor/FreeRTOS-Kernel"]
	path = firmware_stm32/vendor/FreeRTOS-Kernel
	url = https://github.com/FreeRTOS/FreeRTOS-Kernel
[submodule "firmware_stm32/micro_ros_stm32cubemx_utils"]
	path = firmware_stm32/micro_ros_stm32cubemx_utils
	url = https://github.com/micro-ROS/micro_ros_stm32cubemx_utils.git
	branch = jazzy
